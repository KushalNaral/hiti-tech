# ─── Frontend environment variables ────────────────────────────────
# Copy this file to .env.local for local development.
# Vite exposes variables prefixed with VITE_ to the browser bundle.

# Optional: Override the API base URL (e.g. for a separately deployed API).
# Leave blank to use the default relative path /api (works via Replit proxy).
# VITE_API_BASE_URL=https://api.example.com
