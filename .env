# ─── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgres://app_user:password@localhost:5433/hiti_tech

# ─── Session ───────────────────────────────────────────────────
# Random secret used to sign session cookies (required)
# Generate with: openssl rand -hex 64
SESSION_SECRET=1e840195b01ffcdad1f7d38a0fd98b716c44e0f20b800f17a5bcc4a6f0b61dd8aa8e7b6f89e723a0b6250e2dd1aeb93906c9d4ab9a3536ceae47c5f725ab68ad

# ─── Replit Auth (optional — only needed for Replit OIDC login) ─
# Automatically set in Replit environments
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc

# ─── Server ────────────────────────────────────────────────────
# Port the API server listens on (default: 8080 in dev)
PORT=8080
NODE_ENV=development